    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.4.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
